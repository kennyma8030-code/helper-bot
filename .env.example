# Template for the env vars this project needs. Copy the relevant block,
# fill in values, and paste into Railway's Variables "Raw Editor" (one apply).
# NEVER commit a filled-in version of this file.

# --- test.py (five-bot conversation test) -----------------------------------
# Tokens are ZERO-indexed, bot user ids are ONE-indexed; DISCORD_BOT_0 = 1_bot.
DISCORD_BOT_0=
DISCORD_BOT_1=
DISCORD_BOT_2=
DISCORD_BOT_3=
DISCORD_BOT_4=
1_bot=
2_bot=
3_bot=
4_bot=
5_bot=
ADMIN_USER_ID=
GEMINI_API_KEY=
# Optional: server id for instant slash-command sync (else up to 1h)
GUILD_ID=
# Channel the scheduled conversation runs in. Every 4 hours the bots talk there
# for 5 minutes. Leave empty to switch the schedule off; /test still works.
TEST_CHANNEL_ID=
# Ceiling on ESTIMATED Gemini spend in USD (default 3). Once the recorded total
# crosses it the 4-hour schedule stops for good; raise it and redeploy to
# resume. /test on is not gated by it.
GEMINI_BUDGET_USD=
# REQUIRED for the schedule: spend is tracked in the same Postgres the RAG bot
# uses, so both containers count against one budget. Same value as below.
# Without it the scheduled conversation skips every run and says so in the log.
DATABASE_URL=

# --- bot.py (persona bot + RAG) ----------------------------------------------
DISCORD_TOKEN=
TARGET_USER_ID=
DATABASE_URL=
# Optional: embedding width for db.py (default 768)
EMBED_DIM=
# Optional: nickname lock. Both must be set, or the feature stays off.
# Max 32 characters for the nickname.
NICK_LOCK_USER_ID=
NICK_LOCK_NAME=
